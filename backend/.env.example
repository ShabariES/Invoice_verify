DATABASE_URL=sqlite:///./invoices.db
UPLOAD_DIR=uploads
FRONTEND_ORIGIN=http://localhost:5173
OCR_SERVICE_URL=http://localhost:8001
OCR_SERVICE_TOKEN=replace-with-a-long-random-secret
OCR_REVIEW_THRESHOLD=0.95
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SESSION_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
# Set these in Render/Jenkins secrets to create the first administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
# Store the service account JSON as a secret environment value. Leave blank for local development.
GCS_SERVICE_ACCOUNT_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
INBOUND_INVOICE_EMAIL=invoices@yourdomain.com
MAILGUN_WEBHOOK_SIGNING_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=techjays_notification
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_INBOUND_NUMBER=
# Comma-separated Admin destination numbers with country code, digits only.
WHATSAPP_ADMIN_TO=
ADMIN_WHATSAPP_PHONE=+916369035633
